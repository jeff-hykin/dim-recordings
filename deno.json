{
    "tasks": {
        "dev": "deno run -A --watch backend/main.ts --port 8787",
        "test": "deno test -A backend/ tests/",
        "check": "deno check backend/main.ts && deno task check-endpoints",
        "check-endpoints": "deno run -A scripts/check_endpoints.ts"
    },
    "fmt": {
        "indentWidth": 4,
        "semiColons": false,
        "lineWidth": 120,
        "exclude": ["frontend/dist", "frontend/node_modules", "icon.svg"]
    },
    "lint": {
        "exclude": ["frontend/dist", "frontend/node_modules"]
    },
    "imports": {
        "@std/assert": "jsr:@std/assert@1",
        "@std/yaml": "jsr:@std/yaml@1",
        "playwright-core": "npm:playwright-core@1.56.0"
    }
}
